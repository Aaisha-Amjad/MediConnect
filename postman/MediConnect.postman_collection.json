            "body": {
              "mode": "raw",
              "raw": "{\"patientId\": \"P001\", \"medication\": \"Aspirin\", \"dosage\": \"1x daily\", \"notes\": \"As needed\"}"
            },
            "url": {
              "raw": "{{baseApimUrl}}/prescription/v1/prescriptions",
              "host": ["{{baseApimUrl}}"],
              "path": ["prescription", "v1", "prescriptions"]
            }
          }
        },
        {
          "name": "Rate limit test (429)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseApimUrl}}/prescription/v1/prescriptions/TEST",
              "host": ["{{baseApimUrl}}"],
              "path": ["prescription", "v1", "prescriptions", "TEST"]
            }
          }
        }
      ]
    }
