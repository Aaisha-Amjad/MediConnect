# WSO2 Identity Server
WSO2_IS_HOST=localhost
WSO2_IS_PORT=9443

# WSO2 API Manager
WSO2_APIM_HOST=localhost
WSO2_APIM_PORT=9444

# OAuth2 App Credentials (get these from WSO2 IS after registering the app)
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Mock Services
CLINIC_SERVICE_URL=http://localhost:5001
INSURANCE_SERVICE_URL=http://localhost:5002
PHARMACY_SERVICE_URL=http://localhost:5003

# Ballerina
BALLERINA_PORT=8080

# Feature Flags
APPROVE_ALL=true
WORKFLOW_TIMEOUT_SECONDS=5